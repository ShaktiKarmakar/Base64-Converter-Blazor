@page "/"
@using Base64AppBlazor.Services
@using Microsoft.AspNetCore.Components.Forms
@inject Base64ConverterService ConverterService
@inject IJSRuntime JSRuntime

<PageTitle>Base64 Converter</PageTitle>

<div class="min-h-screen py-12 px-4 sm:px-6 lg:px-8" style="position: relative;">
    <!-- SK Watermark - Subtle -->
    <div class="sk-watermark">SK</div>
    
    <!-- Header Initials -->
    <div class="header-initials">SK</div>
    
    <div class="max-w-4xl mx-auto" style="position: relative; z-index: 1;">
        <div class="text-center mb-8">
            <h1 class="text-4xl font-bold text-gray-900 mb-2">Base64 Converter</h1>
            <p class="text-gray-600">Convert files to base64 and base64 to files</p>
        </div>

        <div class="bg-white rounded-xl shadow-xl p-6 md:p-8 space-y-8" style="position: relative;">
            <!-- SK Small watermark on card -->
            <div class="sk-watermark-small">SK</div>
            <!-- File to Base64 Section -->
            <div class="section-card space-y-4">
                <h2 class="text-2xl font-semibold text-gray-800">File to Base64</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Select File
                        </label>
                        <InputFile OnChange="HandleFileChange" class="block w-full text-sm text-gray-500" />
                        @if (selectedFile != null)
                        {
                            <p class="mt-2 text-sm text-gray-600">
                                Selected: <span class="font-medium">@selectedFile.Name</span> (@((selectedFile.Size / 1024.0).ToString("F2")) KB)
                            </p>
                        }
                    </div>
                    <button
                        @onclick="HandleFileToBase64"
                        disabled="@(loading || selectedFile == null)"
                        class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors font-medium">
                        @if (loading)
                        {
                            <text>Converting...</text>
                        }
                        else
                        {
                            <text>Convert to Base64</text>
                        }
                    </button>
                </div>
            </div>

            <div class="border-t border-gray-200"></div>

            <!-- JSON to Files Section -->
            <div class="section-card space-y-4">
                <h2 class="text-2xl font-semibold text-gray-800">JSON to Files (Base64 Detection)</h2>
                <p class="text-sm text-gray-600">
                    Upload a JSON file or paste JSON content. The app will automatically detect base64 strings and convert them to files.
                </p>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Upload JSON File
                        </label>
                        <InputFile OnChange="@HandleJsonFileChange" accept=".json,application/json" class="block w-full text-sm text-gray-500" />
                        @if (jsonFile != null)
                        {
                            <p class="mt-2 text-sm text-gray-600">
                                Selected: <span class="font-medium">@jsonFile.Name</span> (@((jsonFile.Size / 1024.0).ToString("F2")) KB)
                            </p>
                        }
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Or Paste JSON Content
                        </label>
                        @* Bound on change (not oninput): with oninput every keystroke shipped the
                           entire textarea to the server and the re-render shipped it back. *@
                        <textarea
                            @bind="jsonInput"
                            placeholder='Paste your JSON here...&#10;Example: {"image": "iVBORw0KGgoAAAANS...", "data": "SGVsbG8gV29ybGQ="}'
                            rows="8"
                            class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-mono text-sm">
                        </textarea>
                    </div>
                    @* Not gated on jsonInput: that gate is what forced per-keystroke binding.
                       The handler already validates and reports an empty input. *@
                    <button
                        @onclick="HandleJsonToFiles"
                        disabled="@loading"
                        class="w-full bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors font-medium">
                        @if (loading)
                        {
                            <text>Detecting and Converting...</text>
                        }
                        else
                        {
                            <text>Detect Base64 & Convert to Files</text>
                        }
                    </button>
                    @if (detectedFiles.Count > 0)
                    {
                        <div class="mt-4 p-4 bg-green-50 border border-green-200 rounded-md">
                            <p class="text-sm text-green-800 mb-3 font-medium">
                                Found @detectedFiles.Count file@(detectedFiles.Count > 1 ? "s" : "") ready for download!
                            </p>
                            <div class="space-y-2 mb-4">
                                @* Selection is keyed by index. Keying by Base64Value meant every
                                   render hashed every multi-megabyte base64 string in the list. *@
                                @for (var i = 0; i < detectedFiles.Count; i++)
                                {
                                    var index = i;
                                    var file = detectedFiles[index];
                                    <div @key="index" class="flex items-center justify-between p-2 bg-white rounded border border-green-200">
                                        <div class="flex items-center flex-1">
                                            <input
                                                type="checkbox"
                                                checked="@selectedBase64Files.Contains(index)"
                                                @onchange="@((ChangeEventArgs e) => ToggleBase64Selection(index, (bool)(e.Value ?? false)))"
                                                class="mr-3 h-4 w-4 text-indigo-600 focus:ring-indigo-500 border-gray-300 rounded" />
                                            <div class="flex-1">
                                                <p class="text-sm font-medium text-gray-800">@file.Filename</p>
                                                <p class="text-xs text-gray-500">
                                                    Path: @file.Path • Size: @((file.Size / 1024.0).ToString("F2")) KB • Type: @file.MimeType
                                                </p>
                                            </div>
                                        </div>
                                        <button
                                            @onclick="() => DownloadFile(file.FileData, file.Filename, file.MimeType)"
                                            class="ml-3 bg-green-600 text-white py-1 px-3 rounded text-sm hover:bg-green-700 transition-colors font-medium">
                                            Download
                                        </button>
                                    </div>
                                }
                            </div>
                            <div class="flex gap-2 mb-4 flex-wrap">
                                <button
                                    @onclick="SelectAllBase64"
                                    class="px-3 py-1 bg-indigo-600 text-white rounded text-sm hover:bg-indigo-700 transition-colors font-medium">
                                    Select All
                                </button>
                                <button
                                    @onclick="DeselectAllBase64"
                                    class="px-3 py-1 bg-gray-600 text-white rounded text-sm hover:bg-gray-700 transition-colors font-medium">
                                    Deselect All
                                </button>
                                <button
                                    @onclick="GenerateJsonWithSelectedBase64"
                                    disabled="@(loading || selectedBase64Files.Count == 0)"
                                    class="px-3 py-1 bg-purple-600 text-white rounded text-sm hover:bg-purple-700 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors font-medium">
                                    Generate JSON
                                </button>
                            </div>
                            @if (!string.IsNullOrWhiteSpace(generatedJson))
                            {
                                <div class="mt-4 p-4 bg-blue-50 border border-blue-200 rounded-md">
                                    <p class="text-sm text-blue-800 mb-2 font-medium">Generated JSON Structure:</p>
                                    @* One-way: it is readonly, so @bind only added a pointless
                                       client-to-server sync of a large value. *@
                                    <textarea
                                        value="@generatedJson"
                                        rows="12"
                                        readonly
                                        class="w-full px-4 py-3 border border-blue-300 rounded-md bg-white font-mono text-sm">
                                    </textarea>
                                    <div class="flex gap-2 mt-2 flex-wrap">
                                        <button
                                            @onclick="CopyGeneratedJson"
                                            class="px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 transition-colors font-medium">
                                            Copy JSON
                                        </button>
                                        <button
                                            @onclick="DownloadGeneratedJson"
                                            class="px-3 py-1 bg-blue-600 text-white rounded text-sm hover:bg-blue-700 transition-colors font-medium">
                                            Download JSON
                                        </button>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            </div>

            <div class="border-t border-gray-200"></div>

            <!-- Base64 to File Section -->
            <div class="section-card space-y-4">
                <h2 class="text-2xl font-semibold text-gray-800">Base64 to File</h2>
                <div class="space-y-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-2">
                            Base64 String
                        </label>
                        @* Bound on change (not oninput) -- see the JSON textarea above. This one
                           routinely holds multi-megabyte values, so per-keystroke sync was worst here. *@
                        <textarea
                            @bind="base64String"
                            placeholder="Paste your base64 string here..."
                            rows="8"
                            class="w-full px-4 py-3 border border-gray-300 rounded-md focus:ring-2 focus:ring-indigo-500 focus:border-indigo-500 font-mono text-sm">
                        </textarea>
                    </div>
                    <div class="flex gap-3">
                        <button
                            @onclick="HandleBase64ToFile"
                            disabled="@loading"
                            class="flex-1 bg-indigo-600 text-white py-2 px-4 rounded-md hover:bg-indigo-700 disabled:bg-gray-400 disabled:cursor-not-allowed transition-colors font-medium">
                            @if (loading)
                            {
                                <text>Converting...</text>
                            }
                            else
                            {
                                <text>Convert to File</text>
                            }
                        </button>
                        <button
                            @onclick="CopyToClipboard"
                            class="px-4 py-2 bg-gray-200 text-gray-700 rounded-md hover:bg-gray-300 transition-colors font-medium">
                            Copy
                        </button>
                    </div>
                    @if (downloadFileData != null)
                    {
                        <div class="mt-4 p-4 bg-green-50 border border-green-200 rounded-md">
                            <p class="text-sm text-green-800 mb-2">File ready for download!</p>
                            <button
                                @onclick="() => DownloadFile(downloadFileData, downloadFilename, downloadMimeType)"
                                class="inline-block bg-green-600 text-white py-2 px-4 rounded-md hover:bg-green-700 transition-colors font-medium">
                                Download @downloadFilename
                            </button>
                        </div>
                    }
                </div>
            </div>

            <!-- Error Message -->
            @if (!string.IsNullOrWhiteSpace(errorMessage))
            {
                <div class="mt-4 p-4 bg-red-50 border border-red-200 rounded-md">
                    <p class="text-sm text-red-800">@errorMessage</p>
                </div>
            }

            <!-- Clear Button -->
            <div class="pt-4 border-t border-gray-200">
                <button
                    @onclick="ClearAll"
                    class="w-full bg-gray-200 text-gray-700 py-2 px-4 rounded-md hover:bg-gray-300 transition-colors font-medium">
                    Clear All
                </button>
            </div>
        </div>
    </div>
</div>

@code {
    private IBrowserFile? selectedFile;
    private IBrowserFile? jsonFile;
    private string base64String = "";
    private string jsonInput = "";
    private bool loading = false;
    private string errorMessage = "";
    private byte[]? downloadFileData;
    private string downloadFilename = "";
    private string downloadMimeType = "";
    private List<DetectedFile> detectedFiles = new();
    private HashSet<int> selectedBase64Files = new();
    private string generatedJson = "";

    private const long MaxUploadSize = 50L * 1024 * 1024;

    private void HandleFileChange(InputFileChangeEventArgs e)
    {
        selectedFile = e.File;
        errorMessage = "";
        base64String = "";
        downloadFileData = null;
    }

    private async Task HandleFileToBase64()
    {
        if (selectedFile == null)
        {
            errorMessage = "Please select a file first";
            await InvokeAsync(StateHasChanged);
            return;
        }

        loading = true;
        errorMessage = "";
        base64String = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            using var stream = selectedFile.OpenReadStream(maxAllowedSize: MaxUploadSize);

            // Pass the known size: Blazor's browser file stream reports CanSeek == false, so
            // without it the service cannot pre-size its buffer and grows it by repeated
            // doubling and copying (~13 reallocations for a 50MB file).
            var result = await ConverterService.FileToBase64Async(stream, selectedFile.Name, selectedFile.Size);
            
            if (!string.IsNullOrEmpty(result.base64))
            {
                base64String = result.base64;
                downloadFileData = null;
                errorMessage = "";
            }
            else
            {
                errorMessage = "Conversion resulted in empty base64 string. File may be empty or corrupted.";
                base64String = "";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error converting file: {ex.Message}";
            if (ex.InnerException != null)
            {
                errorMessage += $" ({ex.InnerException.Message})";
            }
            base64String = "";
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task HandleBase64ToFile()
    {
        if (string.IsNullOrWhiteSpace(base64String))
        {
            errorMessage = "Please enter a base64 string";
            await InvokeAsync(StateHasChanged);
            return;
        }

        loading = true;
        errorMessage = "";
        downloadFileData = null;
        downloadFilename = "";
        downloadMimeType = "";
        await InvokeAsync(StateHasChanged);

        try
        {
            // Use Task.Run to offload CPU-intensive work to thread pool
            var result = await Task.Run(() => ConverterService.Base64ToFile(base64String));
            
            downloadFileData = result.fileData;
            downloadFilename = result.filename;
            downloadMimeType = result.mimeType;
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error converting base64: {ex.Message}";
            downloadFileData = null;
            downloadFilename = "";
            downloadMimeType = "";
        }
        finally
        {
            loading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task CopyToClipboard()
    {
        if (string.IsNullOrWhiteSpace(base64String))
        {
            errorMessage = "Nothing to copy";
            return;
        }

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", base64String);
            await JSRuntime.InvokeVoidAsync("alert", "Base64 copied to clipboard!");
        }
        catch
        {
            errorMessage = "Failed to copy to clipboard";
        }
    }

    private async Task HandleJsonFileChange(InputFileChangeEventArgs e)
    {
        jsonFile = e.File;
        errorMessage = "";
        detectedFiles.Clear();

        // Read the JSON file content once, here. HandleJsonToFiles used to re-open and re-read
        // the same file, transferring it over the wire a second time (and discarding any edits
        // the user made in the textarea).
        if (jsonFile != null)
        {
            try
            {
                using var stream = jsonFile.OpenReadStream(maxAllowedSize: MaxUploadSize);
                using var reader = new StreamReader(stream);
                jsonInput = await reader.ReadToEndAsync();
            }
            catch (Exception ex)
            {
                errorMessage = $"Error reading file: {ex.Message}";
            }
        }
    }

    private async Task HandleJsonToFiles()
    {
        if (string.IsNullOrWhiteSpace(jsonInput))
        {
            errorMessage = "Please provide JSON input or upload a JSON file";
            return;
        }

        loading = true;
        errorMessage = "";
        detectedFiles.Clear();
        selectedBase64Files.Clear();
        generatedJson = "";

        try
        {
            // jsonInput already holds the uploaded file's content (read in HandleJsonFileChange),
            // so there is nothing to fetch again here.
            var jsonContent = jsonInput;

            // Offload CPU-intensive JSON parsing to thread pool
            var files = await Task.Run(() => ConverterService.FindBase64InJson(jsonContent));

            if (files.Count == 0)
            {
                errorMessage = "No base64 content detected in the JSON";
                base64String = "";
            }
            else
            {
                detectedFiles = files;
                // Auto-select everything by default.
                selectedBase64Files = new HashSet<int>(Enumerable.Range(0, files.Count));

                // Only mirror into the Base64-to-File box when there is a single match. Joining
                // every payload with "\n\n" produced a string that could not be converted anyway,
                // while pushing the combined size of every detected file over the wire.
                base64String = files.Count == 1 ? files[0].Base64Value : "";
            }
        }
        catch (Exception ex)
        {
            errorMessage = $"Error: {ex.Message}";
        }
        finally
        {
            loading = false;
        }
    }

    private void ToggleBase64Selection(int index, bool isSelected)
    {
        if (isSelected)
        {
            selectedBase64Files.Add(index);
        }
        else
        {
            selectedBase64Files.Remove(index);
        }
    }

    private void SelectAllBase64()
    {
        selectedBase64Files = new HashSet<int>(Enumerable.Range(0, detectedFiles.Count));
    }

    private void DeselectAllBase64()
    {
        selectedBase64Files.Clear();
    }

    private async Task GenerateJsonWithSelectedBase64()
    {
        if (selectedBase64Files.Count == 0 || string.IsNullOrWhiteSpace(jsonInput))
        {
            errorMessage = "Please select at least one base64 string and ensure JSON input is available";
            return;
        }

        loading = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            // Preserve list order rather than HashSet enumeration order.
            var selectedBase64List = detectedFiles
                .Where((_, i) => selectedBase64Files.Contains(i))
                .Select(f => f.Base64Value)
                .ToList();

            var json = jsonInput;

            // Was running synchronously on the render thread, blocking the circuit for the
            // duration of a full parse-and-rewrite of the payload.
            generatedJson = await Task.Run(() => ConverterService.GenerateJsonWithSelectedBase64(json, selectedBase64List));
            errorMessage = "";
        }
        catch (Exception ex)
        {
            errorMessage = $"Error generating JSON: {ex.Message}";
            generatedJson = "";
        }
        finally
        {
            loading = false;
        }
    }

    private async Task CopyGeneratedJson()
    {
        if (string.IsNullOrWhiteSpace(generatedJson))
            return;

        try
        {
            await JSRuntime.InvokeVoidAsync("navigator.clipboard.writeText", generatedJson);
            await JSRuntime.InvokeVoidAsync("alert", "JSON copied to clipboard!");
        }
        catch
        {
            errorMessage = "Failed to copy JSON to clipboard";
        }
    }

    private async Task DownloadGeneratedJson()
    {
        if (string.IsNullOrWhiteSpace(generatedJson))
            return;

        await StreamDownloadAsync(
            System.Text.Encoding.UTF8.GetBytes(generatedJson),
            "generated_json.json",
            "application/json");
    }

    private Task DownloadFile(byte[] fileData, string filename, string mimeType)
        => StreamDownloadAsync(fileData, filename, mimeType);

    /// <summary>
    /// Sends the bytes as binary over the existing connection. The previous data-URL approach
    /// base64-encoded the payload (+33%), interpolated it into a second string of that size, and
    /// then had JS interop JSON-escape the result -- several full copies per download.
    /// </summary>
    private async Task StreamDownloadAsync(byte[] fileData, string filename, string mimeType)
    {
        try
        {
            using var stream = new MemoryStream(fileData, writable: false);
            using var streamRef = new DotNetStreamReference(stream, leaveOpen: true);
            await JSRuntime.InvokeVoidAsync("downloadFileStream", streamRef, filename, mimeType);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to download file: {ex.Message}";
        }
    }

    private void ClearAll()
    {
        selectedFile = null;
        jsonFile = null;
        base64String = "";
        jsonInput = "";
        errorMessage = "";
        downloadFileData = null;
        downloadFilename = "";
        downloadMimeType = "";
        detectedFiles.Clear();
        selectedBase64Files.Clear();
        generatedJson = "";
    }
}

